# Pie cahrt

expenses = [
    "Salaries",
    "Rent",
    "Marketing",
    "Utilities",
    "Software",
    "Travel",
    "Training"
]

amounts = [
    500000,
    120000,
    80000,
    30000,
    50000,
    40000,
    20000
]

explode = [0,0.3,0,0,0,0,0]
plt.pie(amounts,labels=expenses,autopct="%1.1f%%",
       wedgeprops =  {
           "edgecolor":"black",
           "linewidth":1,
           "linestyle":"--",
       },
       explode=explode,
       startangle=45,
        shadow=True
       )



