df = pd.read_csv("globalAirQuality.csv")
print(df)


df.describe()


# Selecting data

# df["city"]
# df[["city","aqi"]]

df.loc[2]
df.loc[0:4] # ending index in inclusive

df.iloc[2]
df.iloc[0:2] # ending index is exclusive

# cell row - columns

df.loc[0,"city"]
df.loc[0:3,["city","pm25"]]

df.iloc[0:3,2:6]

# cell single

df.at[0,"city"] #thsi is view not the data
df.iat[0,2]

copy_city = df["city"].copy()
copy_city[0] = "Solapur"
print(copy_city)


# Filtring
df[df["aqi"] > 100]
df[(df["aqi"] > 100) & (df["temperature"] > 30)]
df[(df["aqi"] > 100) & (df["temperature"] < 30)]

df[df["aqi"] > 100][["city","aqi"]] #chaning

# Query method
df.query("aqi > 100")
df.query("aqi > 100 & temperature > 30")[["city","aqi"]]
api_value = 100
df.query("aqi > @api_value & temperature > 30")[["city","aqi"]]


df
